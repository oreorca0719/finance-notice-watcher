# 이 파일을 .env 로 복사한 뒤 SMTP_PASSWORD 만 채우십시오.
# .env 는 .gitignore 에 등록되어 있어 저장소에 올라가지 않습니다.
#
# ── 발신 서버: 후이즈웍스 (pron.co.kr 의 실제 메일 호스팅) ─────────────
#
#   확인된 사항 (실측):
#     · pron.co.kr MX      → aspmx.whoisworks.com
#     · SPF                → include:spf1.whoisworks.com
#     · smtp.whoisworks.com:587  OPEN, STARTTLS 지원, AUTH LOGIN/PLAIN
#     · 465(SMTPS)는 닫혀 있음 → 반드시 587 + starttls 를 쓸 것
#     · 이 서버는 DH 파라미터가 1024비트라 Python 기본 보안수준에서 거부됨.
#       mailer.py 가 자동으로 보안수준을 완화해 재연결합니다(TLS는 유지).

SMTP_HOST=smtp.whoisworks.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=bjkim@pron.co.kr

# 아래 한 줄만 직접 채우십시오. 후이즈메일 계정 비밀번호입니다.
SMTP_PASSWORD=

SMTP_FROM_NAME=Project Searcher
